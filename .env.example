# Cadena de conexión a PostgreSQL
DATABASE_URL="postgresql://postgres:TU_CLAVE@localhost:5432/skyv"
# Clave secreta para firmar los JWT (larga y aleatoria; NUNCA la subas a GitHub)
JWT_SECRET="cambia-esto-por-una-clave-larga-y-aleatoria"
# Tiempo de vida del token
JWT_EXPIRES_IN="1d"
# Puerto del servidor
PORT=4000
# URLs del frontend que pueden llamar a la API (separadas por coma)
CORS_ORIGIN="http://localhost:3000"